{
  "name": "carbon",
  "version": "0.1.32",
  "description": "Carbon — a beautiful desktop GUI for Claude Code and Codex",
  "type": "module",
  "main": "out/main/index.js",
  "author": "achour",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node --test test/*.test.ts",
    "rebuild": "electron-rebuild -f -o node-pty",
    "postinstall": "electron-rebuild -f -o node-pty",
    "package": "electron-vite build && electron-builder --mac dir",
    "install-app": "npm run package && node scripts/install-app.mjs"
  },
  "devDependencies": {
    "@base-ui/react": "^1.6.0",
    "@electron/rebuild": "^3.6.1",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^43.1.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^5.0.0",
    "highlight.js": "^11.11.1",
    "lucide-react": "^1.24.0",
    "mermaid": "^11.16.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "zustand": "^5.0.14"
  },
  "allowScripts": {
    "electron@43.1.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true
  },
  "//dependencies": "Only packages the Electron MAIN process require()s at runtime belong here — electron-builder ships exactly the production-dependency tree into the app. The renderer's libraries (react, mermaid, lucide, base-ui, xterm, markdown, fonts, …) are bundled into out/renderer by vite at build time, so they live in devDependencies and are pruned from the package (~200MB). See electron-builder.yml.",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.227",
    "@openai/codex-sdk": "0.147.0",
    "node-pty": "^1.1.0"
  }
}
